<!DOCTYPE html>
<html>
<head>
  <title>Agenda</title>
  <%= stylesheet_link_tag    "application", :media => "all" %>
  <%= javascript_include_tag "application" %>
  <%= csrf_meta_tags %>
</head>
<body>

  <header>
    <p>Desafio Agenda - Ruby On Rails</p>
  </header>

  <div id="menu">
    <ul class="main-menu">
      <%= menu "Home", root_path %>
      <%= menu "Usuários", usuarios_path %>
      <%= menu "Contatos", contatos_path %>
      <%= menu "Telefones", telefones_path %>
    </ul>
  </div>

  <%= yield %>

</body>
<br><hr>
<footer>Ruby v2.1.2 <br>Rails v3.2.22.5</footer>
</html>
