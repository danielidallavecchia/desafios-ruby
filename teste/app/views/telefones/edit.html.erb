
<div class="form-corpo-padrao">
  <div class="show-titulo">
    <h1>Editar telefone</h1>
  </div>

  <%= render "form" %>

  <div class="show-botoes">
    <%= link_to "Ver", telefone_path(@telefone), class: "index-botao" %>
    <%= link_to "Voltar aos telefones", telefones_path, class: "index-botao" %>
  </div>

  <% if @telefone.errors.any? %>
    <div class="erro-form">
      Erro: <%= @telefone.errors.full_messages.first %>
    </div>
  <% end %>
</div> 
