
<div>
  <h1>Editar telefone</h1>

  <%= render "form" %>

  <%= link_to "Ver", telefone_path(@telefone) %> |
  <%= link_to "Voltar aos telefones", telefones_path %>

  <% if @telefone.errors.any? %>
    <div class="erro-form">
      <%= @telefone.errors.full_messages.first %>
    </div>
  <% end %>
</div> 
