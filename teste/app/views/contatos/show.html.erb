<!DOCTYPE html>
<html>
  <header></header>
  <body>

  <h1>Contato</h1>

  <p>
    <strong>ID:</strong>
    <%= @contato.id %>
  </p>

  <p>
    <strong>Nome:</strong>
    <%= @contato.nome %>
  </p>

  <p>
    <strong>Sobrenome:</strong>
    <%= @contato.sobrenome %>
