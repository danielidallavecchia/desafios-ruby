
<%= form_for(@contato) do |f| %>
  <div>
    <%= f.label :nome do %>
      Nome <span class="campo-required">*</span>
    <% end %>
    <br>
    <%= f.text_field :nome %>
  </div>
  <div>
    <%= f.label :sobrenome do %>
      Sobrenome <span class="campo-required">*</span>
    <% end %>
    <br>
    <%= f.text_field :sobrenome %>
  </div>

  <div>
    <%= f.label :usuario_id, "Usuário" %><br />
    <%= f.collection_select :usuario_id, @usuarios, :id, :nome%>
  </div>

  <div>
    <%= f.submit "Salvar" %>
  </div>
<% end %>
