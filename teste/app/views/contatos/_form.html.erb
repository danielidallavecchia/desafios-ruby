
<%= form_for(@contato) do |f| %>
  <div>
    <%= f.label :nome %><br>
    <%= f.text_field :nome %>
  </div>
  <div>
    <%= f.label :sobrenome %><br>
    <%= f.text_field :sobrenome %>
  </div>
  <div>
    <%= f.label :usuario_id, "Usuário" %><br />
    <%= f.collection_select :usuario_id, @usuarios, :id, :nome, include_blank: "Selecione um usuário" %>
  </div>
  <div>
    <%= f.submit "Salvar" %>
  </div>
<% end %>
