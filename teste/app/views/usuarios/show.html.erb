<div>

  <h1>Usuário</h1>

  <p>
    <strong>ID:</strong>
    <%= @usuario.id %>
  </p>

  <p>
    <strong>Nome:</strong>
    <%= @usuario.nome %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= @usuario.email %>
  </p>

  <p>
    <strong>Data de nascimento:</strong>
    <%= @usuario.data_nascimento %>
  </p>

  <p>
    <strong>Contatos:</strong>
    <% if @usuario.contatos.any? %>
      <ul>
        <% @usuario.contatos.each do |contato| %>
          <li> <%= link_to "#{contato.id} - #{contato.nome}", contato_path(contato) %> </li>
        <% end %>
      </ul>
      
    <% else %>
      (Sem contatos associados)
    <% end %>
  </p>

  <%= link_to "Editar", edit_usuario_path(@usuario) %> |
  <%= link_to "Voltar aos usuários", usuarios_path %>

</div>
