<!DOCTYPE html>
<html>
  <header></header>
  <body>

  <h1>Usuário</h1>

  <p>
    <strong>ID:</strong>
    <%= @usuario.id %>
  </p>

  <p>
    <strong>Nome:</strong>
    <%= @usuario.nome %>
  </p>

  <p>
    <strong>Email:</strong>
