
<%= form_for(@usuario) do |f| %>
  <div>
    <%= f.label :nome %><br>
    <%= f.text_field :nome %>
  </div>
  <div>
    <%= f.label :email %><br>
    <%= f.text_field :email %>
  </div>
  <div>
    <%= f.label :data_nascimento %><br>
    <%= f.text_field :data_nascimento %>
  </div>

  <% if !logado? || @usuario.new_record? %>
    <div>
      <%= f.label :senha %><br>
      <%= f.password_field :senha %>
    </div>
  <% end %>

  <div>
    <%= f.submit "Salvar" %>
  </div>
<% end %>
