
<div class="login-caixa">
  <h1>Mudar senha</h1>

  <%= form_tag muda_senha_path, method: :put do %>
    <div class="login-campo">
      <%= label_tag :senha_atual, "Senha atual" %>
      <%= password_field_tag :senha_atual %>
    </div>

    <div class="login-campo">
      <%= label_tag :nova_senha, "Nova senha" %>
      <%= password_field_tag :nova_senha %>
    </div>

    <div class="login-campo">
      <%= label_tag :confirmacao, "Confirmar nova senha" %>
      <%= password_field_tag :confirmacao %>
    </div>

    <%= submit_tag "Salvar", class: "login-botao" %>
  <% end %>
</div>

<% if flash.any? %>
  <div class="exibe-flash">
    <% flash.each do |tipo, msg| %>
      <p class="<%= tipo %>"><%= msg %></p>
    <% end %>
  </div>
<% end %>
